# Copy this file to .env.local and replace placeholders with your API credentials.
# These values are server-only. Never prefix them with NEXT_PUBLIC_.
# Used only as an Indeed fallback when direct Indeed access is blocked.
SERPAPI_KEY=your_serpapi_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
AI_PROVIDER=deepseek
# Optional if you route DeepSeek-compatible traffic through a gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required for production email verification.
APP_BASE_URL=https://your-production-domain.example
EMAIL_FROM="LazyHire <verify@your-production-domain.example>"
RESEND_API_KEY=your_resend_api_key
# If EMAIL_FROM is omitted while RESEND_API_KEY is set, development uses
# "LazyHire <onboarding@resend.dev>" for Resend test delivery.

# Optional alternative to Resend. Use app passwords where your provider requires them.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Optional local/test outbox path. Development without RESEND_API_KEY writes here.
EMAIL_DEV_OUTBOX=./data/email-outbox.jsonl

# Required in production. Generate independent 32+ character values.
AUTH_SECRET=replace_with_32_plus_random_chars
AUTH_HMAC_SECRET=replace_with_32_plus_random_chars
DATA_ENCRYPTION_KEY=replace_with_32_plus_random_chars

# Optional local SQLite path (relative to the project root).
DATABASE_PATH=./data/orvio.sqlite

# Career tutor: download the local embedding model once with npm run kb:embed.
# Requests do not download models or send query embeddings to an external provider.
TUTOR_MODEL_CACHE=./data/models
